; Engine configuration file.
config_version=5

[application]

config/name="Five Sols on Mars"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
boot_splash/bg_color=Color(0.0627451, 0.0784314, 0.121569, 1)
boot_splash/image="res://assets/abertura.png"
boot_splash/use_filter=false
config/icon="res://assets/icone.png"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/stretch/mode="viewport"
window/stretch/scale_mode="fractional"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
2d/snap/snap_2d_transforms_to_pixel=true

[internationalization]

locale/translations=PackedStringArray("res://textos/textos.en.translation", "res://textos/textos.pt.translation")
locale/fallback="en"
